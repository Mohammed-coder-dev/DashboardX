# All variables are optional — the app runs without any of them.

# Server-side Anthropic key used as a fallback when a request carries no
# x-anthropic-key header. Leave unset for a bring-your-own-key demo.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Supabase project for analysis history + share links. When unset, history
# is disabled and the app still works. Use the project URL and the
# publishable (anon) key from Project Settings → API. Server-side only —
# never shipped to the browser.
SUPABASE_URL=
SUPABASE_KEY=

# Local port (defaults to 3000).
PORT=

# Per-IP, per-minute limits. Counters are per running instance.
RATE_LIMIT_POINTS=10
RATE_LIMIT_ASK_POINTS=20

# Days a saved analysis stays readable. Unset (or 0) keeps it until the person
# who saved it deletes it. The window is applied when an analysis is read.
RETENTION_DAYS=
