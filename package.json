{
  "name": "ridge",
  "version": "2.1.0",
  "description": "Ridge turns spreadsheets and structured files into traceable findings, quality diagnostics, statistical evidence, and clear explanations.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run tests --exclude tests/browser",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser",
    "video": "node video/verify.js && node video/capture.js && node video/narrate.js && node video/build.js",
    "video:verify": "node video/verify.js",
    "video:capture": "node video/capture.js",
    "video:narrate": "node video/narrate.js",
    "video:build": "node video/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAlkindi/Ridge.git"
  },
  "keywords": [
    "data-analysis",
    "spreadsheet",
    "data-quality",
    "statistics",
    "evidence",
    "anthropic",
    "express",
    "vercel"
  ],
  "author": "Mohammed Alkindi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MohammedAlkindi/Ridge/issues"
  },
  "homepage": "https://github.com/MohammedAlkindi/Ridge#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.110.9",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "officeparser": "^6.0.4",
    "pdf2json": "^4.0.2",
    "rate-limiter-flexible": "^10.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
