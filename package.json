{
  "name": "dashboardx",
  "version": "2.0.0",
  "description": "Upload a spreadsheet, get statistics, correlations, and AI insights back.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run tests --exclude tests/browser",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammedAlkindi/DashboardX.git"
  },
  "keywords": [
    "dashboard",
    "data-analysis",
    "claude",
    "excel",
    "ai"
  ],
  "author": "Mohammed Alkindi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MohammedAlkindi/DashboardX/issues"
  },
  "homepage": "https://github.com/MohammedAlkindi/DashboardX#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.110.9",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "officeparser": "^6.0.4",
    "pdf2json": "^4.0.2",
    "rate-limiter-flexible": "^10.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
